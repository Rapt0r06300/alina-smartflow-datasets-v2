    "SCOREBOARD": {
      "required_files": ["catalog/DATASET_HEALTH_RECEIPT.json"],
      "required_coverage": {"replayable_shards": {"min": 1}}
    },
    "DONE": {
      "required_files": ["catalog/DATASET_HEALTH_RECEIPT.json"],
      "required_coverage": {"replayable_shards": {"min": 1}}
    }
  },
